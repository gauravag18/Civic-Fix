# Copy to .env.local and fill in locally. Never commit real values.
# Both variables are server-only: do not rename them with a NEXT_PUBLIC_ prefix.

# Neon pooled PostgreSQL URL for the server runtime. Never commit a real value.
# Do not prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Secret used by Auth.js to sign and encrypt sessions. Configured in a later phase.
AUTH_SECRET=
