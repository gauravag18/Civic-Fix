# Copy to .env and fill in locally. Never commit real values.
# Every variable below is server-only. Do not add a NEXT_PUBLIC_ prefix.

# Pooled Neon URL for the application runtime.
DATABASE_URL=

# Direct Neon URL for Prisma CLI migrations. The application runtime does not use this.
DIRECT_URL=

# Signs Auth.js JWT session cookies. Generate a long random value locally.
# NextAuth 4.24 reads NEXTAUTH_SECRET. If that is unset, AUTH_SECRET is used.
NEXTAUTH_SECRET=
AUTH_SECRET=

# Public origin of this app, without a trailing path. Example: http://localhost:3000
# An https origin marks the Auth.js cookies Secure. Google's redirect URI is
# this origin plus /api/auth/callback/google.
NEXTAUTH_URL=

# How many reverse proxies append to X-Forwarded-For before the app.
# One proxy is the default. The client address is taken from that hop, not the
# leftmost value, which a caller can spoof. Use 0 to ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=

# Google OAuth. Leave both empty until real credentials exist.
# The app builds and runs without them. The login page keeps Google unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required before verification or password-reset email can be sent.
# Leave these empty until an SMTP provider is chosen. Do not invent values.
# Registration and password reset stay blocked while any of these are missing.
APP_ORIGIN=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
