    "db:seed-transitions": "tsx prisma/seed-transitions.ts",
    "admin:bootstrap": "tsx prisma/bootstrap-admin.ts",
    "test": "tsx --test src/lib/auth/password.test.ts src/lib/auth/service.test.ts src/lib/auth/email.test.ts src/lib/auth/rate-limit.test.ts src/lib/auth/google.test.ts src/lib/auth/security.test.ts src/lib/issues/issues.test.ts src/lib/issues/staff.test.ts src/lib/issues/discovery.test.ts src/lib/issues/map-privacy.test.ts src/lib/admin/admin.test.ts src/lib/analytics/analytics.test.ts"
  },
  "dependencies": {
